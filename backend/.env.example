# Copy to backend/.env for local use. Never commit real secrets.
# Paths below are local defaults. Docker/Render override paths and hosting flags.
# Model examples select Gemini 3.5 Flash-Lite; check project access and quotas.

# Writable source, SQLite, BM25 and local-vector directory; needs durable storage to persist.
ASKREPO_DATA_DIR=data

# JSON array of exact frontend origins, without trailing slashes.
ASKREPO_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Comma-separated trusted proxy CIDRs; * is direct-platform-ingress trust only.
ASKREPO_TRUSTED_PROXIES=

# Local CPU embedding model in full mode.
ASKREPO_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local CPU cross-encoder model; disabled in lite mode.
ASKREPO_RERANKER_MODEL=BAAI/bge-reranker-base

# Number of indexing workers. Keep 1 on small hosts.
ASKREPO_INDEXING_CONCURRENCY=1

# open locally; allowlist or token for a public demo.
ASKREPO_INDEXING_MODE=open

# Backend-only secret for X-Admin-Token in token mode; never commit a real value.
ASKREPO_ADMIN_TOKEN=

# Total repository byte cap applied in lite mode, in addition to regular limits.
ASKREPO_LITE_MAX_REPO_BYTES=20971520

# Total file cap in lite mode; checked before checkout and source loading.
ASKREPO_LITE_MAX_FILES=1500

# Distinct admitted URLs per UTC day across clients; ledger needs persistent SQLite.
ASKREPO_MAX_NEW_REPOS_PER_DAY=20

# Skip individual source files larger than this byte count.
ASKREPO_MAX_FILE_BYTES=307200

# Maximum total tracked/read repository bytes before filtering.
ASKREPO_MAX_REPO_BYTES=104857600

# Maximum total tracked/read repository file count before filtering.
ASKREPO_MAX_FILES=10000

# Maximum seconds allowed for Git cloning and checkout.
ASKREPO_CLONE_TIMEOUT_SECONDS=180

# Maximum on-disk clone size, including Git objects.
ASKREPO_MAX_CLONE_BYTES=209715200

# Chunking strategy: ast or fixed.
ASKREPO_CHUNK_STRATEGY=ast

# Maximum characters per source chunk.
ASKREPO_MAX_CHUNK_CHARS=6000

# Pending queue capacity in addition to active workers.
ASKREPO_MAX_QUEUED_JOBS=20

# Rebuild missing/stale demo artifacts in the background; enable on ephemeral hosting.
ASKREPO_BOOTSTRAP_DEMOS=false

# Stable unique deployment name; separates deterministic demo IDs across deployments.
ASKREPO_DEPLOYMENT_ID=local

# JSON array of canonical public GitHub demo URLs; also the indexing allowlist.
ASKREPO_DEMO_REPOS=["https://github.com/ShlokMaharwal/Seekr","https://github.com/ShlokMaharwal/CodeNest","https://github.com/ShlokMaharwal/DPTrace"]

# Initial background retry delay; exponential backoff is capped at one hour.
ASKREPO_BOOTSTRAP_RETRY_SECONDS=60

# Maximum texts per Gemini embedding request, at most 32.
ASKREPO_GEMINI_EMBEDDING_BATCH_SIZE=32

# Embedding requests per minute, separately paced from generation.
ASKREPO_GEMINI_EMBEDDING_RPM=10

# Bounded retries for transient embedding provider errors.
ASKREPO_GEMINI_EMBEDDING_RETRIES=3

# Initial exponential embedding retry delay; failed batches can resume.
ASKREPO_GEMINI_EMBEDDING_BACKOFF_SECONDS=5

# CPU threads used by local neural models.
ASKREPO_MODEL_THREADS=4

# Local full-mode model cache; Docker uses /opt/models.
ASKREPO_MODEL_CACHE=data\models

# Gemini embedding model used by lite mode; output dimension is 768.
ASKREPO_GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Confidence gate for normalized hybrid RRF scores.
ASKREPO_FUSION_THRESHOLD=0.55

# Confidence gate for normalized keyword scores.
ASKREPO_BM25_THRESHOLD=0.15

# Confidence gate for vector similarity scores.
ASKREPO_VECTOR_THRESHOLD=0.55

# Confidence gate for local cross-encoder scores.
ASKREPO_RERANK_THRESHOLD=0.2

# Fallback generation model. Example selects a current model; code default is legacy.
ASKREPO_GEMINI_MODEL=gemini-3.5-flash-lite

# Rewrite/grader model override; verify availability for your Gemini project.
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# Final-answer model override; empty falls back to ASKREPO_GEMINI_MODEL.
GEMINI_ANSWER_MODEL=gemini-3.5-flash-lite

# Hard cap on text-provider attempts, including retries, per logical question.
MAX_LLM_CALLS_PER_QUESTION=3

# Server-wide agentic switch; public demo recommends false.
AGENTIC_ENABLED=true

# Top score required to skip the optional model grader.
ASKREPO_AGENTIC_GOOD_SCORE=0.65

# Lower threshold required for at least two chunks in the cheap grading rule.
ASKREPO_AGENTIC_LOWER_SCORE=0.35

# Global text-provider requests per minute, excluding embedding calls.
ASKREPO_LLM_GLOBAL_RPM=10

# Text-provider requests per resolved client IP per minute.
ASKREPO_LLM_PER_IP_RPM=6

# Maximum seconds to wait in the provider quota queue.
ASKREPO_LLM_QUEUE_WAIT_SECONDS=2

# Maximum provider-quota waiters.
ASKREPO_LLM_MAX_QUEUED=32

# Retries for transient text-provider errors; also bounded by the question cap.
ASKREPO_LLM_MAX_RETRIES=2

# Initial exponential text-provider retry delay.
ASKREPO_LLM_RETRY_BACKOFF_SECONDS=0.5

# Maximum complete validated answers cached in memory; zero disables caching.
ASKREPO_ANSWER_CACHE_SIZE=128

# Lifetime in seconds of complete validated cached answers.
ASKREPO_ANSWER_CACHE_TTL_SECONDS=600

# auto selects Gemini when a key exists, otherwise source excerpts; gemini or extractive also supported.
ASKREPO_LLM_PROVIDER=auto

# Total generation context character budget.
ASKREPO_MAX_CONTEXT_CHARS=100000

# API requests per resolved IP per minute; compare costs three units.
ASKREPO_ASK_RATE_PER_MINUTE=30

# Index API requests per resolved IP per minute.
ASKREPO_INDEX_RATE_PER_MINUTE=5

# Maximum JSON request body size in bytes.
ASKREPO_MAX_REQUEST_BYTES=32768

# Optional full-mode CPU int8 quantization.
ASKREPO_QUANTIZE_MODELS=false

# Include linear layers in int8 quantization; false quantizes embedding tables only.
ASKREPO_QUANTIZE_LINEARS=true

# Local full-mode embedding batch size.
ASKREPO_EMBEDDING_BATCH_SIZE=16

# Local full-mode reranker batch size.
ASKREPO_RERANKER_BATCH_SIZE=4

# Local embedding input token cap; changing it requires compatible fresh indexes.
ASKREPO_EMBEDDING_MAX_LENGTH=512

# Local reranker input token cap.
ASKREPO_RERANKER_MAX_LENGTH=512

# Use Gemini embeddings and omit local neural models. Also set this at Docker build time.
LITE_MODE=false

# Gemini secret. Add only to ignored local .env or hosting secrets.
GEMINI_API_KEY=

# Empty uses local Qdrant. Cloud example: https://YOUR_CLUSTER_HOSTNAME:443.
QDRANT_URL=

# Database API key with collection write permission; never commit a real value.
QDRANT_API_KEY=
